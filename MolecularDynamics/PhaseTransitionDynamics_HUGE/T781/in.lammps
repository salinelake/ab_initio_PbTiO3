variable        NSTEPS          equal 25000
variable        THERMO_FREQ     equal 5
variable        DUMP_FREQ       equal 500
variable        dt              equal 0.002
variable        PRES            equal 28000.0
variable        TAU_T           equal 100*${dt}
variable        TAU_P           equal 1000*${dt}
variable        restart         equal 0
variable        TEMP1           equal 800
# ---------------------- INITIALIZAITION ------------------
units           metal
boundary        p p p
atom_style      atomic
restart         5000 pto.rest1 pto.rest2
#read_restart   pto.rest1 

# --------------------- ATOM DEFINITION ------------------
read_data       conf.lmp
replicate       1 1 1
mass            1 15.999400
mass            2 207.200000
mass            3 47.867000
# --------------------- FORCE FIELDS ---------------------
pair_style      deepmd frozen_model.pb
pair_coeff      * *
# --------------------- MD SETTINGS ----------------------
neighbor        1.0 bin
timestep        ${dt}
thermo          ${THERMO_FREQ}
thermo_style    custom step temp pe ke etotal press vol density lx ly lz
# --------------------- thermo SETTINGS ----------------------
velocity        all create ${TEMP1} ${SEED} dist gaussian
fix             mzero all momentum 1000 linear 1 1 1
fix             init all npt temp 800 800 ${TAU_T} iso ${PRES} ${PRES} ${TAU_P}
run             5000
unfix           init
fix             init2 all npt temp 800 782 ${TAU_T} aniso ${PRES} ${PRES} ${TAU_P}
run             20000
unfix           init2
reset_timestep 	0


fix             stat all npt     temp ${TEMP} ${TEMP} 5 aniso ${PRES} ${PRES} 5
dump            1    all custom ${DUMP_FREQ} pto0ps.lammpstrj id type x y z
run             ${NSTEPS}
undump          1

dump            1    all custom ${DUMP_FREQ} pto50ps.lammpstrj id type x y z
run             ${NSTEPS}
undump          1

dump            1    all custom ${DUMP_FREQ} pto100ps.lammpstrj id type x y z
run             ${NSTEPS}
undump          1

dump            1    all custom ${DUMP_FREQ} pto150ps.lammpstrj id type x y z
run             ${NSTEPS}
undump          1
