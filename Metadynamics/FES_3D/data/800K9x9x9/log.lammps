LAMMPS (29 Oct 2020)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:94)
  using 1 OpenMP thread(s) per MPI task
variable        NSTEPS          equal 16000000
variable        THERMO_FREQ     equal 1000
variable        DUMP_FREQ       equal 10000
variable        dt              equal 0.0005
variable        PRES            equal 28000.000000
variable        TAU_T           equal 100*${dt}
variable        TAU_T           equal 100*0.0005
variable        TAU_P           equal 1000*${dt}
variable        TAU_P           equal 1000*0.0005
variable        restart         equal 0

# ---------------------- INITIALIZAITION ------------------
units           metal
boundary        p p p
atom_style      atomic
restart         5000 pto.rest1 pto.rest2
#read_restart   pto.rest1

# --------------------- ATOM DEFINITION ------------------
#box          tilt large
#change_box   all triclinic
read_data       cubic.lmp
Reading data file ...
  orthogonal box = (0.0000000 0.0000000 0.0000000) to (34.616692 34.616692 34.616692)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  3645 atoms
  read_data CPU = 0.006 seconds
replicate       1 1 1
Replicating atoms ...
  orthogonal box = (0.0000000 0.0000000 0.0000000) to (34.616692 34.616692 34.616692)
  1 by 1 by 1 MPI processor grid
  3645 atoms
  replicate CPU = 0.001 seconds
# change_box all x scale 1.022 y scale 1.022 z scale 1.022 remap
mass            1 15.999400
mass            2 207.200000
mass            3 47.867000
# --------------------- FORCE FIELDS ---------------------
pair_style      deepmd frozen_model.pb
pair_coeff
# --------------------- MD SETTINGS ----------------------
neighbor        1.0 bin
timestep        ${dt}
timestep        0.0005
thermo          ${THERMO_FREQ}
thermo          1000
thermo_style    custom step temp pe ke etotal press vol density lx ly lz
dump            1 all custom ${DUMP_FREQ} pto.lammpstrj id type x y z
dump            1 all custom 10000 pto.lammpstrj id type x y z

# --------------------- thermo SETTINGS ----------------------
#if "${restart} == 0" then "velocity        all create ${TEMP} 562280"


velocity        all create ${TEMP} 562280 dist gaussian
velocity        all create 800 562280 dist gaussian
fix             mzero all momentum 1000 linear 1 1 1
# fix             init all npt temp ${TEMP} ${TEMP} ${TAU_T} iso ${PRES} ${PRES} ${TAU_P}
# run             10000
# unfix           init
# reset_timestep 	0

fix             1 all plumed plumedfile plumed.dat outfile plumed.out
# fix             2 all nph aniso ${PRES} ${PRES} ${TAU_P}
# fix             3 all temp/csvr ${TEMP} ${TEMP} ${TAU_T} 12345
fix             2 all npt temp ${TEMP} ${TEMP} ${TAU_T} aniso ${PRES} ${PRES} ${TAU_P}
fix             2 all npt temp 800 ${TEMP} ${TAU_T} aniso ${PRES} ${PRES} ${TAU_P}
fix             2 all npt temp 800 800 ${TAU_T} aniso ${PRES} ${PRES} ${TAU_P}
fix             2 all npt temp 800 800 0.05 aniso ${PRES} ${PRES} ${TAU_P}
fix             2 all npt temp 800 800 0.05 aniso 28000 ${PRES} ${TAU_P}
fix             2 all npt temp 800 800 0.05 aniso 28000 28000 ${TAU_P}
fix             2 all npt temp 800 800 0.05 aniso 28000 28000 0.5

# run             1000
run             ${NSTEPS}
run             16000000
