# vim:ft=plumed

########### CV ###########
dipole: DEEPDIPOLE MODEL=dipole.pb ATYPE=type.raw UNIT_CVT=1.0
CUSTOM ...
  LABEL=cv1
  ARG=dipole.x,dipole.y,dipole.z
  VAR=x,y,z
  FUNC=sqrt(x*x+y*y+z*z)/1728
  PERIODIC=NO
... CUSTOM

METAD ...
 LABEL=metad
 ARG=cv1
 SIGMA=0.05
 TAU=50
 BIASFACTOR=24
 TEMP=815
 PACE=250
 GRID_MIN=0.0
 GRID_MAX=3.0
 GRID_BIN=300
 CALC_RCT
... METAD

UPPER_WALLS ...
 ARG=cv1
  AT=2.5
 KAPPA=10000.0
 LABEL=uwall
... UPPER_WALLS

PRINT ARG=* STRIDE=100 FILE=COLVAR

#endofinput 
ENDPLUMED